{
  "name": "filebox",
  "version": "0.1.0",
  "author": "Obi Fortune <gabrielobi.of@gmail.com>",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun run --bun drizzle-kit generate",
    "db:migrate": "bun run --bun drizzle-kit migrate",
    "db:studio": "bun run --bun drizzle-kit studio",
    "db:run-extract": "bun run --bun ./drizzle/scripts/extract.ts",
    "db:run-seed": "bun run --bun ./drizzle/scripts/seed.ts"
  },
