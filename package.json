    "@mantine/hooks": "^7.8.0",
    "@mantine/notifications": "^7.8.0",
    "@paralleldrive/cuid2": "paralleldrive/cuid2",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tabler/icons-react": "^3.35.0",
    "@vercel/analytics": "^1.2.2",
